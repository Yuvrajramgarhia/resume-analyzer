rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() { return request.auth != null; } // email verification relaxed for demo
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.size() >= 4
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && data.role in ['candidate', 'recruiter', 'institution'];
    }
    
    function isValidResume(data) {
        return data.userId is string && data.userId.size() <= 128
          && data.fileName is string && data.fileName.size() <= 256
          && data.status in ['processing', 'completed', 'failed']
          && data.isPublic is bool;
    }

    match /usernames/{username} {
      allow get: if isValidId(username);
      allow create: if isSignedIn() && isValidId(username)
        && incoming().keys().hasAll(['email'])
        && incoming().email == request.auth.token.email;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid
        && isValidUser(incoming()) 
        && incoming().keys().hasAll(['uid', 'email', 'role', 'name']);
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid
        && isValidUser(incoming())
        && incoming().uid == existing().uid;
    }

    match /resumes/{resumeId} {
      allow get: if isSignedIn() && isValidId(resumeId) && (existing().userId == request.auth.uid || existing().isPublic == true);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isSignedIn() && isValidId(resumeId) 
        && isValidResume(incoming()) 
        && incoming().userId == request.auth.uid;
      allow update: if (isSignedIn() && isValidId(resumeId)) && (
        (existing().userId == request.auth.uid && incoming().userId == existing().userId && isValidResume(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'atsScore', 'parsedData', 'roleTarget', 'updatedAt', 'isPublic', 'metrics', 'roadmap']))
      );
      allow delete: if isSignedIn() && isValidId(resumeId) && existing().userId == request.auth.uid;
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow write: if false; // System generated only via admin SDK
    }

    match /applications/{applicationId} {
      allow get: if isSignedIn() && isValidId(applicationId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(applicationId) 
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(applicationId) && existing().userId == request.auth.uid;
    }

    match /application_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /job_alerts/{alertId} {
      allow get: if isSignedIn() && isValidId(alertId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(alertId) 
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && isValidId(alertId) && existing().userId == request.auth.uid;
    }

    match /candidate_profiles/{userId} {
      allow get: if true; // Publicly readable for public profiles
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }

    match /recruiter_profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }

    match /institution_profiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }

    match /agent_chats/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;
    }
  }
}
